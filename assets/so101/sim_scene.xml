<mujoco model="so101 sim table">
    <!-- Simulation scene for `scripts/ui.py --sim` (src/so101_zero_shot/mujoco_sim.py): the arm on a table
         with a few graspable objects in front of it. scene.xml (no objects) stays the one used for
         planning renders, collision checks and the gripper mask. Object layout here is the reset pose. -->
    <include file="so101_new_calib.xml" />

    <option timestep="0.002" cone="elliptic" impratio="10" />

    <visual>
        <headlight diffuse="0.45 0.45 0.45" ambient="0.35 0.35 0.35" specular="0 0 0" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.85 0.87 0.9" rgb2="0.5 0.52 0.55" width="512" height="3072" />
        <!-- Low-contrast wood-ish table with a faint 5 cm grid, so monocular depth has some texture. -->
        <texture type="2d" name="table" builtin="checker" mark="edge" rgb1="0.56 0.40 0.27" rgb2="0.52 0.37 0.25"
            markrgb="0.47 0.33 0.22" width="400" height="400" />
        <material name="table" texture="table" texuniform="true" texrepeat="20 20" />
        <material name="red" rgba="0.85 0.12 0.10 1" />
        <material name="blue" rgba="0.12 0.30 0.85 1" />
        <material name="yellow" rgba="0.95 0.80 0.10 1" />
        <material name="green" rgba="0.15 0.65 0.25 1" />
        <material name="marker_body" rgba="0.08 0.08 0.08 1" />
        <material name="marker_band" rgba="0.92 0.92 0.92 1" />
        <material name="skin" rgba="0.87 0.67 0.54 1" />
        <material name="sleeve" rgba="0.25 0.32 0.45 1" />
    </asset>

    <default>
        <default class="object">
            <geom friction="1.5 0.02 0.002" condim="4" solref="0.004 1" />
        </default>
        <!-- Round things need rolling friction (condim 6) or one nudge sends them rolling off the table. -->
        <default class="round">
            <geom friction="1.5 0.02 0.01" condim="6" solref="0.004 1" />
        </default>
    </default>

    <worldbody>
        <light pos="0.3 0.3 1.2" dir="-0.2 -0.2 -1" diffuse="0.5 0.5 0.5" castshadow="false" />
        <light pos="0.2 -0.5 1.0" dir="0 0.4 -1" diffuse="0.25 0.25 0.25" castshadow="false" />
        <geom name="floor" size="0 0 0.05" type="plane" material="table" />

        <body name="red_cube" pos="0.22 0.08 0.015">
            <freejoint />
            <geom class="object" type="box" size="0.015 0.015 0.015" material="red" mass="0.03" />
        </body>
        <body name="blue_can" pos="0.27 -0.07 0.035">
            <freejoint />
            <geom class="object" type="cylinder" size="0.016 0.035" material="blue" mass="0.05" />
        </body>
        <body name="yellow_ball" pos="0.18 -0.10 0.02">
            <freejoint />
            <geom class="round" type="sphere" size="0.02" material="yellow" mass="0.03" />
        </body>
        <body name="marker" pos="0.29 0.02 0.009" euler="90 0 0">
            <freejoint />
            <geom class="round" type="capsule" size="0.009 0.05" material="marker_body" mass="0.02" />
            <geom class="round" type="cylinder" size="0.0095 0.012" pos="0 0 -0.02" material="marker_band" mass="0.002" />
        </body>
        <body name="green_block" pos="0.30 -0.13 0.02" euler="0 0 30">
            <freejoint />
            <geom class="object" type="box" size="0.012 0.03 0.02" material="green" mass="0.04" />
        </body>

        <!-- A person's right hand for hand-interaction tests (benchmark, SimWorld.set_hand). Kinematic
             (mocap): it stays where it is put and the arm cannot push it. Body frame: fingers along +x,
             palm facing -z, thumb toward +y. Parked out of view until placed. -->
        <body name="hand" mocap="true" pos="-0.6 0.6 0.1">
            <geom name="palm" type="box" size="0.040 0.042 0.013" material="skin" />
            <geom type="capsule" fromto="0.040 0.030 0 0.088 0.032 0" size="0.0085" material="skin" />
            <geom type="capsule" fromto="0.040 0.010 0 0.098 0.011 0" size="0.009" material="skin" />
            <geom type="capsule" fromto="0.040 -0.010 0 0.094 -0.011 0" size="0.009" material="skin" />
            <geom type="capsule" fromto="0.040 -0.030 0 0.080 -0.033 0" size="0.008" material="skin" />
            <geom type="capsule" fromto="-0.010 0.042 -0.004 0.030 0.072 -0.006" size="0.0095" material="skin" />
            <geom type="capsule" fromto="-0.040 0 0 -0.160 0 0" size="0.030" material="sleeve" contype="0" conaffinity="0" />
        </body>
    </worldbody>
</mujoco>
